VITE_GTM_ID=GTM-XXXXXXX
# Chỉ dùng GA4 trực tiếp khi không dùng GTM. Nếu có GTM, cấu hình GA4 trong GTM.
VITE_GA4_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=123456789012345

# Server-only Meta Conversions API settings. Never prefix the access token with VITE_.
META_PIXEL_ID=123456789012345
META_CAPI_ACCESS_TOKEN=replace_with_a_new_secret_token
META_GRAPH_API_VERSION=v23.0
# Optional while validating events in Meta Events Manager.
META_TEST_EVENT_CODE=
